      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "captura", "accept": ["image/*"] },
        {
          "name": "grabacion",
          "accept": [
            "audio/*",
            "audio/ogg",
            "audio/opus",
            "audio/mpeg",
            "audio/mp4",
            "audio/aac",
            "audio/wav",
            "audio/webm",
            ".opus",
            ".ogg",
            ".mp3",
            ".m4a",
            ".aac",
            ".wav"
          ]
        }
      ]
    }
  }
}
