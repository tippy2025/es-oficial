# Análisis de mensajes e imágenes (motor principal)
# Si están las dos, se usa Anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Transcripción de notas de voz (y alternativa de análisis si no hay Anthropic).
# Se saca gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_AUDIO=gemini-flash-latest

# Alternativa para transcribir si no querés usar Gemini
# OPENAI_API_KEY=
