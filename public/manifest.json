{
  "name": "¿Es Oficial? — Antes de responder, preguntá",
  "short_name": "¿Es Oficial?",
  "description": "Pegá el mensaje sospechoso, compartí la captura o la nota de voz y te decimos en segundos si tiene señales de estafa y qué hacer.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f2f2",
  "theme_color": "#232d4f",
  "lang": "es-AR",
  "categories": ["utilities", "security"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
